# Where Spring Boot is running. Used by the Vite dev proxy and the Swagger link.
VITE_BACKEND_ORIGIN=http://localhost:8080

# Leave empty in development: requests go to a relative /api and Vite proxies them,
# so the browser sees a same-origin app (no CORS preflight, clean token streaming).
#
# Set it to an absolute origin when serving the built bundle from somewhere that
# is not in front of the backend, e.g.:
# VITE_API_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=
